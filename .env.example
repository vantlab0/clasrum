# ---------------------------------------------------------------------------
# AI Personal Classroom — environment template. Copy to .env at repo root.
# ---------------------------------------------------------------------------

APP_NAME="AI Personal Classroom"
ENVIRONMENT=development
DEBUG=true

# --- database --------------------------------------------------------------
# Production / docker-compose:
# DATABASE_URL=postgresql+asyncpg://classroom:classroom@localhost:5432/classroom
# Local zero-dependency development:
DATABASE_URL=sqlite+aiosqlite:///./dev.db
DB_ECHO=false

# --- auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-0123456789abcdef
JWT_EXPIRES_MINUTES=20160

# Comma separated or JSON list, e.g. *. In development "*" is fine.
CORS_ORIGINS=*

# --- Supabase (optional: accept Supabase access tokens in backend) ---------
# If set, backend can verify Supabase-issued JWTs (HS256 legacy project JWT
# secret) and map authenticated Supabase users to local backend users for
# existing ownership/data flows. Never expose service-role keys to clients.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- Alibaba Qwen Realtime -------------------------------------------------
# DashScope API key. Leave empty to run the offline fake tutor (dev/demo/CI).
QWEN_API_KEY=
QWEN_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_MODEL=qwen-omni-turbo-realtime
QWEN_VOICE=Cherry
QWEN_INPUT_SAMPLE_RATE=16000
QWEN_OUTPUT_SAMPLE_RATE=24000
QWEN_TURN_DETECTION=server_vad
# Force the deterministic offline tutor even when a key is configured.
QWEN_FAKE_MODE=false

# --- Structured notes generation (text model, OpenAI-compatible) -----------
NOTES_MODEL=qwen-plus
NOTES_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Falls back to QWEN_API_KEY when empty.
NOTES_API_KEY=

# --- board / lesson behaviour ---------------------------------------------
BOARD_SNAPSHOT_INTERVAL_EVENTS=40
BOARD_SNAPSHOT_KEEP=5
