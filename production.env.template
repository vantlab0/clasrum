# AI Personal Classroom - Production Environment
# ==============================================
# This file should be placed on your VPS at:
# /opt/ai-classroom/backend/.env
# Never commit this file to git (it's in .gitignore)

# === Application Settings ===
APP_NAME=AI Personal Classroom
ENVIRONMENT=production
DEBUG=false
TIMEZONE=UTC

# === Security ===
JWT_SECRET=change-this-to-a-minimum-32-character-secret-key-production-ready
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=20160
CORS_ORIGINS=https://realtime.avelut.xyz,https://www.avelut.xyz
ALLOWED_HOSTS=realtime.avelut.xyz,localhost,127.0.0.1

# === Database ===
# Production: PostgreSQL (recommended)
DATABASE_URL=postgresql+asyncpg://classroom:classroom@localhost:5432/classroom

# SQLite (fallback/development only - NOT for production)
# DATABASE_URL=sqlite+aiosqlite:////opt/ai-classroom/backend/data/prod.db

# === AI Services ===
QWEN_API_KEY=sk-your-qwen-api-key-here
QWEN_FAKE_MODE=false
QWEN_BASE_URL=https://api.openai.com/v1

# === File Storage ===
# Local file storage path
MEDIA_ROOT=/opt/ai-classroom/backend/data/uploads
MEDIA_URL=/uploads/

# === Email (optional) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=AI Classroom <noreply@avelut.xyz>

# === Security Headers ===
# These are handled by nginx, but set as defaults
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SECURE_BROWSER_XSS_FILTER=true
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=false  # Set true if using HTTPS behind load balancer
CSRF_COOKIE_SECURE=false      # Set true if using HTTPS behind load balancer

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=/opt/ai-classroom/logs/app.log